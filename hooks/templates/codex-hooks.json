{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{PROJECT_DIR}}/.owner/hooks/erp-check.mjs\" --tool codex",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{PROJECT_DIR}}/.owner/hooks/erp-predeploy.mjs\" --tool codex",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{PROJECT_DIR}}/.owner/hooks/erp-reminder.mjs\" --tool codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
