        "indeans-erp-check"
      ]
    },
    {
      "session": 2,
      "title": "저장·배포와 사람",
      "skills": [
        "indeans-erp-review",
        "indeans-erp-data",
        "indeans-erp-people"
      ]
    },
    {
      "session": 3,
      "title": "채널과 운영 보고",
      "skills": [
        "indeans-erp-channel",
        "indeans-erp-digest"
      ]
    },
    {
      "session": 4,
      "title": "흐름 확장과 검수·복구",
